{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_SHOWCASE=1 npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/samples/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
